# Babylon terminal. Night at 90%, compositor blur behind it.

font-family = JetBrainsMono Nerd Font
font-family = JetBrainsMono Nerd Font
font-size = 10.5
adjust-cell-height = 30%
window-padding-x = 16
window-padding-y = 16
window-decoration = none
background-opacity = 0.90
background-blur = true

background = #0B0908
foreground = #E8DFC9
cursor-color = #F4D675
cursor-text = #0B0908
cursor-style = block
cursor-style-blink = false
selection-background = #1E1810
selection-foreground = #F0E7D2

# Search and splits in the theme's colours (ghostty's stock yellow and orange otherwise).
search-background = #7FA4E2
search-foreground = #0B0908
search-selected-background = #F4D675
search-selected-foreground = #0B0908
split-divider-color = #3A2E1A
unfocused-split-fill = #0B0908

palette = 0=#0B0908
palette = 1=#EB4B50
palette = 2=#9DBB6A
palette = 3=#D4A72C
palette = 4=#7FA4E2
palette = 5=#B48ACB
palette = 6=#6CC0B5
palette = 7=#A99B80
palette = 8=#6B5D42
palette = 9=#F47C7F
palette = 10=#B7D088
palette = 11=#F4D675
palette = 12=#A6C1EE
palette = 13=#CFABE0
palette = 14=#93D6CC
palette = 15=#F0E7D2
