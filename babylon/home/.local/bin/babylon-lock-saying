#!/usr/bin/env python3
"""Lock-screen saying (Babylon, tategaki in Shippori Mincho B1). No username.

    babylon-lock-saying jp1      first Japanese column (rightmost), one glyph per line
    babylon-lock-saying jp2      second column (to its left), and so on
    babylon-lock-saying romaji   the romaji in spaced capitals (turned 90° by hyprlock)
    babylon-lock-saying reading  the katakana reading as a small column, when the saying has one
    babylon-lock-saying          everything on one line

Sayings come from ~/.config/hypr/babylon/sayings.txt, one per line as
"romaji | japanese | reading"; spaces in the Japanese split it into columns (tategaki:
read top to bottom, right to left). The saying changes every 10 minutes; the
index comes from the clock, so all labels show the same saying.
"""

import sys
import time
from html import escape
from pathlib import Path

SAYINGS = Path.home() / ".config/hypr/babylon/sayings.txt"


def current():
    try:
        lines = [l.strip() for l in SAYINGS.read_text(encoding="utf-8").splitlines()]
    except OSError:
        return None
    sayings = [l for l in lines if l and not l.startswith("#")]
    if not sayings:
        return None
    parts = [p.strip() for p in sayings[int(time.time() // 600) % len(sayings)].split("|")]
    parts += [""] * (3 - len(parts))
    return parts[0], parts[1].split(), parts[2]


def main():
    saying = current()
    if not saying:
        return
    romaji, columns, reading = saying
    mode = sys.argv[1] if len(sys.argv) > 1 else ""
    if mode.startswith("jp"):
        n = int(mode[2:] or 1) - 1
        if 0 <= n < len(columns):
            print(f"<span line_height='0.88'>{escape(chr(10).join(columns[n]))}</span>")
        else:
            print("")
    elif mode == "reading":
        print(f"<span line_height='0.88'>{escape(chr(10).join(reading))}</span>" if reading else "")
    elif mode == "romaji":
        print(f"<span letter_spacing='9000'>{escape(romaji.upper())}</span>")
    else:
        print(f"{escape(romaji.upper())}  ─  {escape(' '.join(columns))}")


if __name__ == "__main__":
    main()
